# Server
PORT=8080
CORS_ORIGINS=
PUBLIC_API_BASE_URL=

# MongoDB. Core (users, carts, devices, saved items) and Kira share
# MONGODB_URI; Easysoft uses its own instance at MONGO_URL.
MONGODB_URI=
MONGODB_CORE_DB=bright_core
MONGODB_KIRA_DB=bright_kira
MONGO_URL=
MONGODB_EASYSOFT_DB=bright_easysoft

# JWT (secret must be at least 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_ISSUER=simple-auth-api
JWT_AUDIENCE=simple-auth-client

# SMTP for password reset and enquiries
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Inbox for POST /api/enquiries. Defaults to SMTP_USER.
ENQUIRY_TO=

# Push notifications. The cart reminder and sold stone jobs only run
# when this is exactly "true"; leave it unset on staging.
NOTIFICATIONS_ENABLED=false
# Optional. Sent as a Bearer token to the Expo push API when set.
EXPO_ACCESS_TOKEN=
